# Copy to .env.local and adjust if your Laravel server runs elsewhere.

# Where the Next.js server proxies /backend/* (Laravel `php83 artisan serve`)
LARAVEL_URL=http://127.0.0.1:8000

# Public Laravel URL the browser is sent to (dashboards, password reset).
# Must use the same hostname you open Next.js with (localhost) so the session cookie is shared.
NEXT_PUBLIC_LARAVEL_URL=http://localhost:8000
